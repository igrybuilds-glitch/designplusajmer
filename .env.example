# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# ADMIN ACCESS CONFIGURATION
# Authorized administrator email allowlist (comma-separated or distinct env vars)
ADMIN_EMAIL_1="igrybuilds@gmail.com"
ADMIN_EMAIL_2="designplusajmer@gmail.com"

# ADMIN_SESSION_SECRET: Required in production to sign and verify admin session tokens across restarts.
# If unset, an ephemeral random key is generated on boot (sessions will not survive server restarts).
ADMIN_SESSION_SECRET=""

# ADMIN_BOOTSTRAP_PASSWORD: Optional password for emergency/bootstrap credentials login.
# When unset or empty, password login is strictly disabled (fail-closed) and only verified Google OAuth works.
ADMIN_BOOTSTRAP_PASSWORD=""

# SUPABASE CONFIGURATION
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
